# 本地开发环境变量。这个文件不要提交到版本库（已在 .gitignore 中忽略）。
# Prisma CLI 会自动加载 prisma/ 目录与项目根目录下的 .env。

# MySQL 8.0（本机已作为 Windows 服务运行）
# 把 PASSWORD 换成你本机 MySQL 的密码。
DATABASE_URL="mysql://root:PASSWORD@127.0.0.1:3306/club_management"

# Redis 8.8（本机已作为 Windows 服务运行）
REDIS_URL="redis://127.0.0.1:6379/0"

# JWT 密钥。生产环境必须换成随机长串，不要沿用这个开发值。
JWT_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="2h"
JWT_REFRESH_TTL="14d"

# 文件上传根目录与单文件大小上限（字节）
UPLOAD_DIR="storage/uploads"
UPLOAD_MAX_BYTES=20971520

# 服务端口
PORT=3000
